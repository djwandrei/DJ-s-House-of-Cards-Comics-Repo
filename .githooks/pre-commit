#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then
  powershell_command="pwsh"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell_command="powershell.exe"
else
  echo "PowerShell is required to run scripts/audit-secrets.ps1." >&2
  exit 1
fi

"$powershell_command" -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/audit-secrets.ps1" -Staged
