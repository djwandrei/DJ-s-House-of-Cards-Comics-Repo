# Copy this file outside the repository before filling it in.

# ---------- Stripe ----------
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
SITE_URL=https://www.example.com
ADMIN_CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com
PUBLIC_CORS_ALLOWED_ORIGINS=https://www.example.com,https://example.com
STRIPE_SHIPPING_RATE_ID=replace_with_stripe_shipping_rate_id

# Optional checkout behavior.
STRIPE_ALLOW_FREE_SHIPPING=false
STRIPE_CHECKOUT_HOLD_MINUTES=45
STRIPE_ALLOW_PROMOTION_CODES=false
STRIPE_ALLOW_GUEST_CHECKOUT=true
STRIPE_MAX_ACTIVE_RESERVATIONS_PER_GUEST=5

# ---------- Sale notifications ----------
# Configure either direct email through Resend, an outbound automation webhook,
# or both. Leave blank to keep sale processing active without sending emails.
SALE_NOTIFICATION_EMAIL_TO=admin@example.com
SALE_NOTIFICATION_EMAIL_FROM="DJ's House of Cards <sales@example.com>"
SALE_NOTIFICATION_EMAIL_REPLY_TO=admin@example.com
SALE_NOTIFICATION_SUBJECT_PREFIX=DJHC Sale
RESEND_API_KEY=replace_with_resend_api_key
SALE_NOTIFICATION_WEBHOOK_URL=
SALE_NOTIFICATION_WEBHOOK_SECRET=
SALE_NOTIFICATION_INBOUND_SECRET=replace_with_random_inbound_webhook_secret
# Inquiry messages reuse the sale email settings by default. Set these only to
# route collector inquiries to a different mailbox or verified sender.
INQUIRY_NOTIFICATION_EMAIL_TO=
INQUIRY_NOTIFICATION_EMAIL_FROM=
INQUIRY_NOTIFICATION_EMAIL_REPLY_TO=
# Negotiated offers use the same Resend setup by default. Set these only when
# offers should use a different mailbox, sender, or admin allow-list.
OFFER_NOTIFICATION_EMAIL_TO=
OFFER_NOTIFICATION_EMAIL_FROM=
OFFER_NOTIFICATION_EMAIL_REPLY_TO=
OFFER_EXPIRATION_DAYS=7
# Optional fallback if Shopify order webhooks are unavailable; can duplicate
# order emails when both are active, so keep false unless intentionally needed.
SALE_NOTIFY_SHOPIFY_INVENTORY_ZERO=false

# ---------- Supabase ----------
# Supabase normally injects these automatically for Edge Functions.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key

# ---------- Shopify ----------
# Keep these values in Supabase Edge Function secrets, never in static site files.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=replace_with_shopify_app_client_id
SHOPIFY_CLIENT_SECRET=replace_with_shopify_app_client_secret
SHOPIFY_TOKEN_ENCRYPTION_KEY=replace_with_at_least_24_random_characters
SHOPIFY_REQUEST_TIMEOUT_MS=15000
SHOPIFY_OAUTH_SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_publications,write_publications,read_themes,write_themes,read_orders
SHOPIFY_OAUTH_CALLBACK_URL=https://your-project-ref.supabase.co/functions/v1/shopify-oauth-callback
# Optional fallback only for legacy admin-created custom apps.
SHOPIFY_ADMIN_ACCESS_TOKEN=replace_with_shopify_admin_access_token
SHOPIFY_API_VERSION=2026-04
NOTIFICATION_WORKER_SECRET=replace_with_random_notification_worker_secret

# ---------- cPanel / Hosting ----------
CPANEL_HOST=ftp.example.com
CPANEL_FTPS_USERNAME=replace_with_cpanel_username
CPANEL_FTPS_PASSWORD=replace_with_cpanel_password
CPANEL_REMOTE_PATH=/public_html
CPANEL_PROTOCOL=ftps
